# Optional Easy-ELK configuration.
# Copy to .env only for local use. Do not commit real secrets.

# Elastic version selection
ELASTIC_MAJOR=9
# ELASTIC_VERSION=9.4.1

# Linux standalone Kibana reverse-proxy basic auth
KIBANA_USER=admin
KIBANA_PASSWORD=change-me

# macOS tarball install directory
# EASY_ELK_HOME=$HOME/easy-elk

# Vagrant sandbox
EASY_ELK_BOX=ubuntu/noble64
EASY_ELK_PROVIDER=virtualbox
EASY_ELK_PROXY_SCRIPT=easyELKnginx.sh
